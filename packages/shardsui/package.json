{
  "name": "@shardsui/svelte",
  "version": "0.1.0-beta.0",
  "description": "Headless, accessible UI components for Svelte 5.",
  "license": "MIT",
  "author": "abdrizik",
  "homepage": "https://github.com/abdrizik/shardsui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdrizik/shardsui.git",
    "directory": "packages/shardsui"
  },
  "bugs": "https://github.com/abdrizik/shardsui/issues",
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "ui",
    "components",
    "headless",
    "unstyled",
    "accessible",
    "wai-aria",
    "primitives"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/node_modules"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "dev": "svelte-kit sync && svelte-package --watch",
    "build": "svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "pnpm build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:jsdom": "VITEST_ENV=jsdom vitest run",
    "test:chromium": "VITEST_ENV=chromium vitest run",
    "test:firefox": "VITEST_ENV=firefox vitest run",
    "test:webkit": "VITEST_ENV=webkit vitest run",
    "test:package": "pnpm build && publint --pack pnpm",
    "test:package:types": "pnpm build && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12",
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@sveltejs/kit": "catalog:dev",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "catalog:dev",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "svelte": "catalog:dev",
    "svelte-check": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "chrome >= 121",
    "edge >= 121",
    "firefox >= 97",
    "safari >= 18.2",
    "ios_saf >= 18.2"
  ]
}
